# Copy this file to .streamlit/secrets.toml and fill in your own values.
# Never commit the real secrets.toml to GitHub.
# On Streamlit Cloud, paste these into Settings -> Secrets instead.

OPENAI_API_KEY = "sk-your-key-here"

# From Supabase -> Connect -> Session pooler.
# Use the read-only user created by setup_readonly_user.sql.
DATABASE_URL = "postgresql://app_readonly.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Optional: the OpenAI model to use (default is gpt-4o-mini)
# OPENAI_MODEL = "gpt-4o-mini"
